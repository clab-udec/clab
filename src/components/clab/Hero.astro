---
import hero from '~/assets/images/lab-hero.png';
import udec from '~/assets/images/logo-udec.png';
---

<section
  id="home"
  class="relative h-[500px] flex items-center justify-center overflow-hidden"
>
  <!-- Imagen de fondo -->
  <img
    src={hero.src}
    alt="CLab Laboratory"
    class="absolute inset-0 w-full h-full object-cover object-[50%_40%]"
  />

  <!-- Capa oscura -->
  <div class="absolute inset-0 bg-black/50"></div>

  <!-- Contenido -->
  <div class="relative z-10 text-center px-6">
    <h1
  class="text-white font-extrabold leading-[1.15]
         text-4xl
         md:text-6xl
         lg:text-7xl"
>
  Organic Synthesis &
  <br />
  Molecular Design
</h1>

  </div>
</section>
<section class="bg-white py-12">
  <div class="max-w-5xl mx-auto px-8">

    <p class="text-xl leading-9 text-gray-700 text-justify">
       <strong>CLab</strong> is a research group at the
      <strong>University of Concepción, Chile.</strong>
      Our research focuses on the development of synthetic methodologies for the efficient assembly of complex organic molecules and the discovery of biologically active compounds. We integrate cascade reactions, catalytic processes, and function-oriented molecular design to access molecular architectures inspired by natural products and medicinally relevant compounds. Our research is directed toward therapeutic applications in breast cancer, Alzheimer's disease, and cardiovascular disorders.
    </p>

    <p class="mt-8 text-lg leading-8 text-gray-700">
      <strong>Interested in joining CLab?</strong><br /> Please send your CV and a cover letter to
      <a href="mailto:cparra@udec.cl" class="text-sky-700 hover:underline">cparra@udec.cl</a>
      or
      <a href="mailto:maxmartinez@udec.cl" class="text-sky-700 hover:underline">maxmartinez@udec.cl</a>.
    </p>

  
</section>