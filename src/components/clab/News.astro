---
import jovenesNews from '~/assets/images/jovenesNews.png';
import claqNews from '~/assets/images/claqNews.jpeg';
import micaNews from '~/assets/images/micaNews.jpeg';
---

<section class="bg-white pt-1 pb-20">
  <div class="max-w-5xl mx-auto px-6">

    <!-- SECTION DIVIDER -->
    <div class="border-t border-gray-300 mb-12"></div>


    <!-- TITLE -->
    <div class="text-center mb-10">
      <h2 class="text-4xl xl:text-5xl font-bold text-slate-900">
        Latest News
      </h2>

      <div class="w-24 h-1 bg-amber-400 mx-auto mt-5"></div>
    </div>


    <!-- NEWS GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">



<!-- NEWS 1 — THESIS DEFENSE -->

<article
  class="bg-white rounded-xl overflow-hidden border border-gray-200
         shadow-md hover:shadow-lg transition-shadow duration-300"
>

  <div class="aspect-[4/3] bg-gray-100">
    <img
      src={micaNews.src}
      alt="Mica celebrating her thesis defense"
      class="w-full h-full object-cover"
    />
  </div>

  <div class="p-6">

    <p class="text-sm text-gray-500 mb-2">
    October 29, 2026
    </p>

    <h3 class="text-lg font-bold text-slate-900 mb-3">
      Congratulations, Mica!
    </h3>

    <p class="text-slate-600 leading-7">
      Congratulations to Mica on successfully completing her thesis! We are incredibly proud of your achievement and wish you every success in this exciting new chapter. All the best for the future!
    </p>

    <a
      href="https://www.instagram.com/p/DfPvcDmkViB/?img_index=1"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block mt-5 text-sky-700 font-semibold hover:underline"
    >
      View on Instagram →
    </a>

  </div>

</article>


      <!-- NEWS 2 — CLAQ 2026 -->

<article
  class="bg-white rounded-xl overflow-hidden border border-gray-200
         shadow-md hover:shadow-lg transition-shadow duration-300"
>

  <div class="aspect-[4/3] bg-gray-100">
    <img
      src={claqNews.src}
      alt="CLab researchers at CLAQ 2026 in Lima, Peru"
      class="w-full h-full object-cover"
    />
  </div>

  <div class="p-6">

    <p class="text-sm text-gray-500 mb-2">
      October 12-15, 2026
    </p>

    <h3 class="text-lg font-bold text-slate-900 mb-3">
      CLab at CLAQ 2026
    </h3>

    <p class="text-slate-600 leading-7">
      Our researchers, Dra.(c) Camila Linares-Pipon and Dr. Claudio Parra, represented CLab at the XXVII Latin American Chemistry Congress (CLAQ 2026) in Lima, Peru.
    </p>

    <a
      href="https://www.instagram.com/p/DerCfNDESmN/?img_index=1"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block mt-5 text-sky-700 font-semibold hover:underline"
    >
      View on Instagram →
    </a>

  </div>

</article>
         
      <!-- NEWS 3 — YOUNG RESEARCHERS MEETING -->

<article
  class="bg-white rounded-xl overflow-hidden border border-gray-200
         shadow-md hover:shadow-lg transition-shadow duration-300"
>

  <div class="aspect-[4/3] bg-gray-100">
    <img
      src={jovenesNews.src}
      alt="First Meeting of Young Researchers in Organic Chemistry"
      class="w-full h-full object-cover"
    />
  </div>

  <div class="p-6">

    <p class="text-sm text-gray-500 mb-2">
      September 24, 2026
    </p>

    <h3 class="text-lg font-bold text-slate-900 mb-3">
      First Meeting of Young Researchers in Organic Chemistry
    </h3>

    <p class="text-slate-600 leading-7">
      The First Meeting of Young Researchers in Organic Chemistry was attended by Dr. Eduardo Pereira, Dean of our Faculty, and our Graduate Studies Director.
    </p>

    <a
      href="https://www.instagram.com/p/Dd1zzsllvrB/?img_index=1"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block mt-5 text-sky-700 font-semibold hover:underline"
    >
      View on Instagram →
    </a>

  </div>

</article>

    <!-- INSTAGRAM BUTTON -->
    <div class="flex justify-center mt-12">

      <a
        href="https://www.instagram.com/clab_udec/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3
               bg-slate-800 text-white font-semibold
               px-8 py-4 rounded-lg shadow-md
               hover:bg-slate-700 transition"
      >
        <span class="text-xl">◎</span>
        View more on Instagram
      </a>

    </div>

  </div>
</section>

