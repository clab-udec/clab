---
import ENJI from '~/assets/images/ENJI.jpg';
import fondefNews from '~/assets/images/news-fondef.jpg';
import carlosNews from '~/assets/images/news-carlos.jpg';
---

<section class="bg-white pt-1 pb-20">
  <div class="max-w-5xl mx-auto px-6">

    <!-- SECTION DIVIDER -->
    <div class="border-t border-gray-300 mb-12"></div>


    <!-- TITLE -->
    <div class="text-center mb-10">
      <h2 class="text-4xl xl:text-5xl font-bold text-slate-900">
        Latest News
      </h2>

      <div class="w-24 h-1 bg-amber-400 mx-auto mt-5"></div>
    </div>


    <!-- NEWS GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">


<!-- NEWS 1 — YOUNG RESEARCHERS MEETING -->

  <article
    class="bg-white rounded-xl overflow-hidden border border-gray-200
           shadow-md hover:shadow-lg transition-shadow duration-300"
  >

    <div class="aspect-[4/3] bg-gray-100">
      <img
        src={ENJI.src}
        alt="Young Researchers Meeting in Organic Chemistry"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="p-6">

      <p class="text-sm text-gray-500 mb-2">
        September 20, 2026
      </p>

      <h3 class="text-lg font-bold text-slate-900 mb-3">
        Young Researchers Meeting in Organic Chemistry
      </h3>

      <p class="text-slate-600 leading-7">
        CLab invites the scientific community to the Young Researchers Meeting in Organic Chemistry, a gathering focused on sharing research, discussing science, and generating new connections.
      </p>

      <a
        href="https://www.instagram.com/p/Ddhdt1nxp2x/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block mt-5 text-sky-700 font-semibold hover:underline"
      >
        View on Instagram →
      </a>

    </div>

  </article>


      <!-- NEWS 2 -->
      <article
        class="bg-white rounded-xl overflow-hidden border border-gray-200 shadow-md
               hover:shadow-lg transition-shadow duration-300"
      >

        <!-- IMAGE -->
        <div class="aspect-[4/3] bg-gray-100">
          <img
            src={fondefNews.src}
            alt="New FONDEF I+D project awarded to CLab"
            class="w-full h-full object-cover"
          />
        </div>


        <!-- CONTENT -->
        <div class="p-6">

          <p class="text-sm text-gray-500 mb-2">
            September 10, 2026
          </p>

          <h3 class="text-lg font-bold text-slate-900 mb-3">
            New FONDEF I+D Project
          </h3>

          <p class="text-slate-600 leading-7">
            CLab is part of a new FONDEF I+D project led by Dr. Rodrigo Hasbún, focused on the sustainable production of a natural alkaloid through plant cell cultures and the development of a scalable biotechnological platform.
          </p>

          <a
            href="https://www.instagram.com/p/DdHaneFRiId/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-5 text-sky-700 font-semibold hover:underline"
          >
            View on Instagram →
          </a>

        </div>
      </article>
         
      <!-- NEWS 3 -->
      <article
        class="bg-white rounded-xl overflow-hidden border border-gray-200 shadow-md
               hover:shadow-lg transition-shadow duration-300"
      >

        <!-- IMAGE -->
        <div class="aspect-[4/3] bg-gray-100">
          <img
            src={carlosNews.src}
            alt="Carlos Arias at his pharmacy undergraduate thesis defense"
            class="w-full h-full object-cover"
          />
        </div>


        <!-- CONTENT -->
        <div class="p-6">

          <p class="text-sm text-gray-500 mb-2">
            August 11, 2026
          </p>

          <h3 class="text-lg font-bold text-slate-900 mb-3">
            Undergraduate Thesis Defense
          </h3>

          <p class="text-slate-600 leading-7">
            Congratulations to Carlos Arias on the successful defense of his thesis at the Faculty of Medicine of the University of La Frontera.
          </p>

          <a
            href="https://www.instagram.com/p/Db5paICkYMq/?img_index=1"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-5 text-sky-700 font-semibold hover:underline"
          >
            View on Instagram →
          </a>

        </div>
      </article>

    <!-- INSTAGRAM BUTTON -->
    <div class="text-center mt-12">

      <a
        href="https://www.instagram.com/clab_udec/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3
               bg-slate-800 text-white font-semibold
               px-8 py-4 rounded-lg shadow-md
               hover:bg-slate-700 transition"
      >
        <span class="text-xl">◎</span>
        View more on Instagram
      </a>

    </div>

  </div>
</section>

