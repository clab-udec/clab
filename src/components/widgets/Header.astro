---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  id={id}
  class="absolute top-4 left-0 right-0 z-50 w-full bg-transparent"
>
  <div class="absolute inset-0"></div>

  <div
    class:list={[
      'relative text-default py-3 px-3 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <!-- LOGO -->
    <div
      class:list={[
        { 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' },
        'flex justify-between',
      ]}
    >
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>

      <div class="flex items-center md:hidden">
          class="flex h-12 w-12 items-center justify-center text-white text-4xl"
  id="menu-button"
  
  aria-label="Open menu"
>
  ☰
</button>
      </div>
    </div>

 <!-- MENÚ ESCRITORIO -->
    <nav
      class="hidden md:flex flex-1 items-center justify-center ml-32"
      aria-label="Main navigation"
    >
      <ul
        class="flex flex-row items-center justify-center gap-12 whitespace-nowrap text-[18px] font-semibold uppercase tracking-wide"
      >
        {
          links.map(({ text, href }) => (
            <li>
              <a
                class:list={[
                  'flex items-center whitespace-nowrap px-2 py-3 text-white hover:text-sky-300 transition-colors duration-200',
                  { 'aw-link-active': href === currentPath },
                ]}
                href={href}
              >
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- MENÚ MÓVIL -->
    <nav
      id="mobile-menu"
      class="hidden md:hidden absolute top-full left-0 right-0 bg-white shadow-xl z-50"
      aria-label="Mobile navigation"
    >
      <ul class="flex flex-col py-3">
        {
          links.map(({ text, href }) => (
            <li>
              <a
                href={href}
                class="block px-6 py-4 text-lg font-semibold text-slate-800 border-b border-slate-100 hover:bg-slate-100"
              >
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>


   
      <!-- BOTONES DERECHA -->
<div
  class:list={[
    { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
    'hidden md:flex items-center justify-end md:justify-self-end',
  ]}
>
  <div class="flex items-center">
        {showToggleTheme && (
          <ToggleTheme iconClass="w-5 h-5" />
        )}

        {showRssFeed && (
          <a
            class="p-2"
            aria-label="RSS Feed"
            href={getAsset('/rss.xml')}
          >
            <Icon name="tabler:rss" class="w-5 h-5" />
          </a>
        )}

        {actions?.length ? (
          <span class="ml-4">
            {actions.map((btnProps) => (
              <Button
                {...btnProps}
                class="ml-2 py-2.5 px-6 font-semibold shadow-none text-sm"
              />
            ))}
          </span>
        ) : (
          ''
        )}
      </div>
    </div>   <!-- fin div.flex -->

  </div>     <!-- fin BOTONES DERECHA -->

</div>       <!-- fin contenedor principal -->

</header>
<script is:inline>
document.addEventListener("DOMContentLoaded", () => {

  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");

  if (!button || !menu) return;

  button.addEventListener("click", () => {
    menu.classList.toggle("hidden");
  });

  menu.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
    });
  });

});
</script>