---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/clab/Hero.astro';
import HeroMobile from '~/components/clab/HeroMobile.astro';

import News from '~/components/clab/News.astro';

const metadata = {
  title: 'CLab | Organic Synthesis & Molecular Design',
};
---

<Layout metadata={metadata}>

  <!-- Desktop -->
  <div class="hidden md:block">
    <Hero />
    <News />
  </div>

  <!-- Mobile -->
  <div class="block md:hidden">
    <HeroMobile />
    <News />
  </div>

</Layout>